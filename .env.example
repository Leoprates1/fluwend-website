# URL pública do site — usada em canonical, Open Graph, sitemap, robots e JSON-LD.
#
# Atenção: por ser NEXT_PUBLIC_*, o valor é embutido durante o BUILD.
# Em Docker/EasyPanel, informe-a como *build argument*, não apenas como
# variável de runtime — senão o HTML gerado continuará com o valor padrão.
NEXT_PUBLIC_SITE_URL=https://fluwend.com.br

# ---------------------------------------------------------------------------
# Medição — as duas também são embutidas no BUILD (mesma regra acima).
#
# Google Analytics 4: analytics.google.com → Admin → Fluxos de dados → Web.
# O código começa com G-.
NEXT_PUBLIC_GA_ID=

# Meta Pixel: business.facebook.com → Gerenciador de Eventos → Fontes de dados.
# É um número de 15 ou 16 dígitos.
NEXT_PUBLIC_FB_PIXEL_ID=
# ---------------------------------------------------------------------------
# Deixar em branco é seguro: sem ID o script não é renderizado e nenhuma
# requisição externa é feita.
